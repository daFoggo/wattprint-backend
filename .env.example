# Copy to .env and change secrets. Used by docker-compose. Empty required values abort compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wattprint
DB_PORT=11096

API_PORT=11093

# CORS for web clients, comma separated
CORS_ORIGINS=http://localhost:11094

# Keycloak (identity service, http://localhost:11095). Bootstrap admin of the Keycloak console: user "admin".
KEYCLOAK_PORT=11095
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Password of the app-level user "admin" (role admin) created when the realm is first imported.
WATTPRINT_ADMIN_PASSWORD=
# Secret of the web dashboard's client `wattprint-web` (>= 32 chars): openssl rand -hex 32
WATTPRINT_WEB_CLIENT_SECRET=
# Service account `wattprint-demo-admin`: creates and deletes demo guest accounts (any long random value)
DEMO_ADMIN_CLIENT_SECRET=
# Google sign-in (Google Cloud Console > Google Auth Platform > Clients > Web application, redirect URI
# http://localhost:11095/realms/wattprint/broker/google/endpoint). Imported into the realm on first start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keycloak mail (sign-up verification, password reset). Unset = the dev mailpit service (inbox http://localhost:11099).
# Production: SMTP_HOST, SMTP_PORT, SMTP_FROM, SMTP_AUTH=true, SMTP_USER, SMTP_PASSWORD, SMTP_STARTTLS=true
SMTP_HOST=
# Issuer clients see (must equal the token iss). A phone with `adb reverse tcp:11095 tcp:11095` uses localhost.
# On a LAN phone also set KEYCLOAK_BIND=0.0.0.0, API_BIND=0.0.0.0 and both of these, e.g. KEYCLOAK_PUBLIC_URL=http://192.168.1.20:11095 and
# KEYCLOAK_ISSUER=http://192.168.1.20:11095/realms/wattprint
KEYCLOAK_PUBLIC_URL=http://localhost:11095
KEYCLOAK_ISSUER=http://localhost:11095/realms/wattprint

# Passwords for the least-privilege DB roles; a role with an empty password is created NOLOGIN
APP_DB_PASSWORD=
INGEST_DB_PASSWORD=
COPILOT_DB_PASSWORD=
AI_DB_PASSWORD=

# Demo accounts of scripts/seed_demo_homes.py (Keycloak policy: 12+ chars, upper, lower, digit, special)
DEMO_PASSWORD=
# Real accounts added as members of the first demo home (comma separated)
DEMO_EXTRA_MEMBERS=

# Copilot (Wappi): LLM through OpenRouter; free-form data questions through wattprint-text2sql-mcp.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
# Chat providers in the order tried; a down one hands over to the next (a provider without a key is skipped).
COPILOT_LLM_ORDER=openrouter,astralx
ASTRALX_CHAT_MODEL=byok/astral-x/claude-haiku-5-5
# Content guard read before Wappi answers (empty: none)
COPILOT_GUARD_MODEL=meta-llama/llama-guard-4-12b
TEXT2SQL_URL=http://host.docker.internal:11101
# Id of the WattPrint connection registered in text2sql, and the shared key its chat endpoint checks.
TEXT2SQL_CONNECTION_ID=
TEXT2SQL_SERVICE_KEY=
# Voice: speech to text and text to speech (AstralX). Empty = the voice endpoints answer 503.
ASTRALX_API_KEY=
# Insight worker mails link here.
DASHBOARD_URL=http://localhost:11092
# Refuse to send anything outside for a person who has not agreed. Turn on only once the dashboard that
# asks for consent is the one deployed (an older one gets 403 from Wappi).
CONSENT_ENFORCED=false
# Nightly cleanup of ordinary tables on the shorter periods; irreversible (see scripts/apply_retention.py).
RETENTION_TIERS=false
# Weather on the Overview and for Wappi, at the home's province. Empty = no weather.
OPENWEATHER_API_KEY=
# A thumbs-down on a Wappi answer is sent to this Telegram chat (the question and the answer, personal data
# already masked). Empty = off. Token: message @BotFather, /newbot. Chat id: add the bot to the chat, send one
# message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id.
FEEDBACK_TELEGRAM_TOKEN=
FEEDBACK_TELEGRAM_CHAT=
