# Copy to .env and change secrets. Used by docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wattprint
DB_PORT=5433

API_PORT=8000
AUTH_PORT=3000

# Better Auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# URL the Expo app uses to reach the auth service (LAN IP for physical devices)
BETTER_AUTH_URL=http://localhost:3000
# Expo deep-link scheme(s), comma separated; must match "scheme" in app.json
EXPO_APP_SCHEMES=wattprint://
# CORS for web clients, comma separated
CORS_ORIGINS=http://localhost:8081
