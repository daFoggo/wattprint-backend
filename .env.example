# Copy to .env and change secrets. Used by docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wattprint
DB_PORT=5433

API_PORT=8000

# CORS for web clients, comma separated
CORS_ORIGINS=http://localhost:8081

# JWT signing key (required, empty aborts compose): generate with openssl rand -hex 32
JWT_SECRET_KEY=

# Passwords for the least-privilege DB roles; a role with an empty password is created NOLOGIN
APP_DB_PASSWORD=
INGEST_DB_PASSWORD=
COPILOT_DB_PASSWORD=

# --- NILM replay (optional, see docs/nilm-simulation.md) -------------------------------------
# Compose overlay with the NILM mounts; add docker-compose.gpu.yml for NVIDIA GPUs:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.nilm.yml:docker-compose.gpu.yml
# PyTorch build baked into the image: cpu (default) or gpu (rebuild after changing it).
# TORCH_EXTRA=cpu
# Host folders mounted read-only into the api container:
# REFIT_DIR=./dataset                      # holds CLEAN_REFIT_081116/ (or the CSVs themselves)
# REFIT_CSV_DIR=/data/CLEAN_REFIT_081116   # folder of the CSVs as seen inside the container
# NILM_REPO_DIR=./third_party/NILMFormer   # clone of adrienpetralia/NILMFormer
# NILM_CKPT_HOST_DIR=./checkpoints         # NILMFormer_custom0_{kettle,microwave,...}.pt
# NILM_SCALE=10000                         # scaler.power_stat2 used when the models were trained
