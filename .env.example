# Copy to .env and change secrets. Used by docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wattprint
DB_PORT=5433

API_PORT=8000

# CORS for web clients, comma separated
CORS_ORIGINS=http://localhost:8081

# JWT signing key: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output-xxxxxxxx
