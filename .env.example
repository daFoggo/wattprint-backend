# Copy to .env and change secrets. Used by docker-compose. Empty required values abort compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wattprint
DB_PORT=5433

API_PORT=8000

# CORS for web clients, comma separated
CORS_ORIGINS=http://localhost:8081

# Keycloak (identity service, http://localhost:8180; 8080 is taken by the separate keycloak-idp stack). Bootstrap admin of the Keycloak console: user "admin".
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Password of the app-level user "admin" (role admin) created when the realm is first imported.
WATTPRINT_ADMIN_PASSWORD=
# Secret of the web dashboard's client `wattprint-web` (>= 32 chars): openssl rand -hex 32
WATTPRINT_WEB_CLIENT_SECRET=
# Google sign-in (Google Cloud Console > Google Auth Platform > Clients > Web application, redirect URI
# http://localhost:8180/realms/wattprint/broker/google/endpoint). Imported into the realm on first start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Issuer clients see (must equal the token iss). A phone with `adb reverse tcp:8180 tcp:8180` uses localhost.
# On a LAN phone also set KEYCLOAK_BIND=0.0.0.0 and both of these, e.g. KEYCLOAK_PUBLIC_URL=http://192.168.1.20:8180 and
# KEYCLOAK_ISSUER=http://192.168.1.20:8180/realms/wattprint
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ISSUER=http://localhost:8180/realms/wattprint

# Passwords for the least-privilege DB roles; a role with an empty password is created NOLOGIN
APP_DB_PASSWORD=
INGEST_DB_PASSWORD=
COPILOT_DB_PASSWORD=
