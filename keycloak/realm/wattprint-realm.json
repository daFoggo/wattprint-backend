{
  "realm": "wattprint",
  "displayName": "Wattprint",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Wattprint administrator"
      },
      {
        "name": "user",
        "description": "Regular Wattprint user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "wattprint-api",
      "name": "Wattprint API",
      "description": "Resource server. It never logs anyone in; it only appears as the audience of access tokens.",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "wattprint-mobile",
      "name": "Wattprint mobile app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "wattprint://auth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "wattprint://auth"
      },
      "protocolMappers": [
        {
          "name": "wattprint-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wattprint-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wattprint-web",
      "name": "Wattprint web dashboard",
      "enabled": true,
      "publicClient": false,
      "secret": "${WATTPRINT_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/auth/callback",
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/sign-in##http://localhost:3000/sign-in"
      },
      "protocolMappers": [
        {
          "name": "wattprint-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wattprint-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@wattprint.local",
      "firstName": "Wattprint",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${WATTPRINT_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ]
    }
  ],
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername",
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-default-role",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "role": "user"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-google",
      "description": "Always send the user to Google (no Keycloak login form)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorConfig": "google-redirect",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "google-redirect",
      "config": {
        "defaultProvider": "google"
      }
    }
  ],
  "browserFlow": "browser-google",
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "eventsExpiration": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0
}
